---
export interface Props {
  instagramUrl: string;
  githubUrl: string;
}
const { instagramUrl, githubUrl } = Astro.props;
---

<nav class="dock" aria-label="Navegación">
  <a href="/" class="dock-item" aria-label="Home">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M3 11l9-8 9 8" />
      <path d="M5 10v10h14V10" />
    </svg>
  </a>

  <a href="/museum" class="dock-item" aria-label="Museum">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="3" y="3" width="18" height="18" rx="2" />
      <circle cx="8.5" cy="8.5" r="1.5" />
      <path d="M21 15l-5-5L5 21" />
    </svg>
  </a>

  <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class="dock-item" aria-label="Instagram">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="2" y="2" width="20" height="20" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
    </svg>
  </a>

  <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="dock-item" aria-label="GitHub">
    <svg viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 .5a12 12 0 00-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.6-4-1.6-.5-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.4-1.3-5.4-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 016 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.7 5.6-5.4 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0012 .5z" />
    </svg>
  </a>

  <button id="theme-toggle" class="dock-item" aria-label="Cambiar tema">
    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </svg>
    <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M21 12.8A9 9 0 1111.2 3 7 7 0 0021 12.8z" />
    </svg>
  </button>
</nav>

<style>
  .dock {
    position: fixed;
    bottom: max(1.5rem, env(safe-area-inset-bottom));
    left: 50%;
    z-index: 100;
    display: flex;
    gap: 0.35rem;
    padding: 0.35rem;
    transform: translateX(-50%);
    border-radius: 999px;
    background: light-dark(rgba(255, 255, 255, 0.7), rgba(20, 20, 20, 0.7));
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  }

  .dock-item {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 50%;
    background: none;
    color: light-dark(#111, #eee);
    cursor: pointer;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .dock-item svg {
    width: 18px;
    height: 18px;
  }

  .dock-item:hover {
    background: light-dark(rgba(0, 0, 0, 0.06), rgba(255, 255, 255, 0.1));
    transform: scale(1.08);
  }

  .icon-moon {
    display: none;
  }

  :global(html.dark) .icon-sun {
    display: none;
  }
  :global(html.dark) .icon-moon {
    display: block;
  }
</style>

<script>
  import "~/scripts/theme-toggle";
</script>
